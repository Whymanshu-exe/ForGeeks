// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique
  name            String
  memberships     Membership[]
  reportedTickets Ticket[]     @relation("TicketReporter")
  assignedTickets Ticket[]     @relation("TicketAssignee")
  comments        Comment[]
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)
}

model Workspace {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  memberships Membership[]
  projects    Project[]
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
}

model Membership {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  name        String
  key         String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tickets     Ticket[]
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model Ticket {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @db.Uuid
  reporterId  String         @db.Uuid
  assigneeId  String?        @db.Uuid
  title       String
  description String?
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter    User           @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    Comment[]
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)

  @@index([projectId, status, updatedAt])
  @@index([assigneeId])
  @@index([reporterId])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([ticketId, createdAt])
}
