// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum TicketStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OAuthProvider {
  GITHUB
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique
  name            String
  oauthAccounts   OAuthAccount[]
  memberships     Membership[]
  reportedTickets Ticket[]       @relation("TicketReporter")
  assignedTickets Ticket[]       @relation("TicketAssignee")
  comments        Comment[]
  activities      Activity[]
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  provider          OAuthProvider
  providerAccountId String
  userId            String        @db.Uuid
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Workspace {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  memberships Membership[]
  projects    Project[]
  activities  Activity[]
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
}

model Membership {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Project {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @db.Uuid
  name             String
  key              String
  nextTicketNumber Int       @default(1)
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tickets          Ticket[]
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model Ticket {
  id          String         @id @default(uuid()) @db.Uuid
  ticketKey   String
  projectId   String         @db.Uuid
  reporterId  String         @db.Uuid
  assigneeId  String?        @db.Uuid
  title       String
  description String?
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  labels      String[]       @default([])
  githubUrl   String?
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter    User           @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    Comment[]
  activities  Activity[]
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)

  @@index([projectId, status, updatedAt])
  @@index([assigneeId])
  @@index([reporterId])
  @@unique([projectId, ticketKey])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([ticketId, createdAt])
}

model Activity {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  actorId     String    @db.Uuid
  ticketId    String?   @db.Uuid
  action      String
  summary     String
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User      @relation(fields: [actorId], references: [id], onDelete: Restrict)
  ticket      Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([ticketId, createdAt])
}
